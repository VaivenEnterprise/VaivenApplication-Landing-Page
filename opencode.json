{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/ling-flash-free",
  "instructions": [
    "constitution.md",
    "memoria.md"
  ],
  "agent": {
    "plan": {
      "model": "opencode/nemotron-3-ultra-free"
    },
    "build": {
      "model": "opencode/nemotron-3-lightning-free"
    },
    "spec-writer": {
      "model": "opencode/nemotron-3-ultra-free"
    },
    "dev-web": {
      "model": "opencode/nemotron-3-lightning-free"
    },
    "devops-mcp": {
      "model": "opencode/nemotron-3-ultra-free",
      "tools": {
        "render_*": true
      }
    },
    "revisor-constitucion": {
      "model": "opencode/big-pickle"
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "node scripts/check.mjs": "allow",
      "python -m http.server*": "allow"
    },
    "render_*": "deny"
  },
  "mcp": {
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:RENDER_API_KEY}"
      },
      "enabled": true
    }
  },
  "tools": {
    "render_*": false
  }
}
